# Environment for the per-robot Zenoh ROUTER on real multi-robot deployments:
# enable multicast scouting so routers on different robots discover and connect
# to each other (router<->router), with gossip for subnets where multicast is lossy.
#   source swarmx_zenoh_router_multirobot.env && ros2 run rmw_zenoh_cpp rmw_zenohd
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ZENOH_CONFIG_OVERRIDE='scouting/multicast/enabled=true;scouting/multicast/autoconnect={router:["router"],peer:["router","peer"],client:["router"]}'
# If multicast is blocked on your Wi-Fi, list the other robots' routers instead:
# export ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/192.168.1.21:7447","tcp/192.168.1.22:7447"]'
