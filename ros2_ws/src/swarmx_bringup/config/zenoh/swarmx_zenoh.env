# Source before launching SwarmX nodes to run ROS 2 over Eclipse Zenoh (rmw_zenoh).
#
# Topology (decentralized, no central server):
#   * every robot runs its OWN Zenoh router: `ros2 run rmw_zenoh_cpp rmw_zenohd`
#     (sim_fleet.launch.py / robot.launch.py start it for you)
#   * all processes on that robot attach to their local router (rmw_zenoh default)
#   * routers of different robots find each other by UDP multicast scouting and
#     exchange only what is subscribed across robots (in SwarmX: /swarmx/p2p)
# A robot that loses Wi-Fi keeps its whole local ROS graph working; losing one
# robot's router only affects that robot.
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
