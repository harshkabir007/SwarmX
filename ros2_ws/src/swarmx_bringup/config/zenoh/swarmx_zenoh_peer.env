# Router-less pure peer mode (every process discovers every other by multicast).
# Verified for small graphs (a handful of processes); for full robots with Nav2
# (dozens of processes per robot) prefer one router per robot: swarmx_zenoh.env.
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ZENOH_ROUTER_CHECK_ATTEMPTS=-1
export ZENOH_CONFIG_OVERRIDE='mode="peer";scouting/multicast/enabled=true;connect/endpoints=[]'
