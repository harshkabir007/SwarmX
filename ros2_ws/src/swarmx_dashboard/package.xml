<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarmx_dashboard</name>
  <version>0.1.0</version>
  <description>Lightweight web dashboard for the SwarmX fleet (passive P2P peer; WebSocket + REST backend, vanilla JS frontend).</description>
  <maintainer email="sorting.tech@shoonyarecycling.in">SwarmX team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>swarmx_core</exec_depend>
  <exec_depend>swarmx_fleet</exec_depend>
  <exec_depend>swarmx_interfaces</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
